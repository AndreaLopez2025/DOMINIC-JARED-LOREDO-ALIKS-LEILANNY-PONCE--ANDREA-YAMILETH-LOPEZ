        "# =========================================\n",
        "# IMPORTACIÓN DE LIBRERÍAS\n",
        "# =========================================\n",
        "\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "\n",
        "# =========================================\n",
        "# SET 1 - GRÁFICA DE BARRAS\n",
        "# =========================================\n",
        "# Aquí trabajamos con datos categóricos (regiones) y sus cantidades\n",
        "\n",
        "# Paso 1: Definimos los datos\n",
        "cats = ['Norte', 'Sur', 'Este', 'Oeste']\n",
        "conteos = np.array([120, 90, 150, 110])\n",
        "\n",
        "# Paso 2: Creamos una figura nueva para que la gráfica no se encime\n",
        "plt.figure()\n",
        "\n",
        "# Paso 3: Hacemos la gráfica de barras\n",
        "plt.bar(cats, conteos)\n",
        "\n",
        "# Paso 4: Agregamos un título para identificar la gráfica\n",
        "plt.title(\"Set 1 - Conteo por región\")\n",
        "\n",
        "# Paso 5: Mostramos la gráfica\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# =========================================\n",
        "# SET 2 - GRÁFICA DE DISPERSIÓN\n",
        "# =========================================\n",
        "# Aquí analizamos la relación entre dos variables numéricas\n",
        "\n",
        "# Paso 1: Generamos los datos\n",
        "n = 120\n",
        "x = np.linspace(0, 100, n)\n",
        "y = 2.0 * x + np.random.normal(0, 25, n)\n",
        "\n",
        "# Paso 2: Nueva figura\n",
        "plt.figure()\n",
        "\n",
        "# Paso 3: Gráfica de dispersión\n",
        "plt.scatter(x, y)\n",
        "\n",
        "# Paso 4: Título\n",
        "plt.title(\"Set 2 - Relación lineal\")\n",
        "\n",
        "# Paso 5: Mostrar\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# =========================================\n",
        "# SET 3 - HISTOGRAMA\n",
        "# =========================================\n",
        "# Aquí analizamos cómo se distribuyen los datos\n",
        "\n",
        "# Paso 1: Datos\n",
        "muestra = np.random.normal(loc=50, scale=10, size=1000) + np.random.exponential(scale=2, size=1000)*0.5\n",
        "\n",
        "# Paso 2: Figura\n",
        "plt.figure()\n",
        "\n",
        "# Paso 3: Histograma\n",
        "plt.hist(muestra)\n",
        "\n",
        "# Paso 4: Título\n",
        "plt.title(\"Set 3 - Distribución de datos\")\n",
        "\n",
        "# Paso 5: Mostrar\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# =========================================\n",
        "# SET 4 - SERIE DE TIEMPO\n",
        "# =========================================\n",
        "# Aquí analizamos datos que cambian con el tiempo\n",
        "\n",
        "# Paso 1: Datos\n",
        "t = np.arange(1, 25)\n",
        "tendencia = 5 + 1.2 * t\n",
        "estacional = 4 * np.sin(2 * np.pi * t / 12)\n",
        "ruido = np.random.normal(0, 2, size=t.shape)\n",
        "serie = tendencia + estacional + ruido\n",
        "\n",
        "# Paso 2: Figura\n",
        "plt.figure()\n",
        "\n",
        "# Paso 3: Gráfica de línea\n",
        "plt.plot(t, serie)\n",
        "\n",
        "# Paso 4: Título\n",
        "plt.title(\"Set 4 - Serie temporal\")\n",
        "\n",
        "# Paso 5: Mostrar\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# =========================================\n",
        "# SET 5 - MATRIZ DE CORRELACIÓN\n",
        "# =========================================\n",
        "# Aquí analizamos la relación entre varias variables\n",
        "\n",
        "# Paso 1: Crear datos\n",
        "df = pd.DataFrame({\n",
        "    'ingresos': np.random.normal(50, 10, 200),\n",
        "    'gasto_marketing': np.random.normal(25, 5, 200),\n",
        "    'clientes_nuevos': np.random.poisson(12, 200) + np.random.normal(0, 1, 200),\n",
        "    'satisfaccion': np.clip(np.random.normal(3.5, 0.7, 200), 1, 5)\n",
        "})\n",
        "\n",
        "# Creamos una variable adicional\n",
        "df['ventas'] = 2.5*df['ingresos'] + 1.1*df['gasto_marketing'] + np.random.normal(0, 8, 200)\n",
        "\n",
        "# Paso 2: Figura\n",
        "plt.figure()\n",
        "\n",
        "# Paso 3: Mapa de calor de correlación\n",
        "sns.heatmap(df.corr(), annot=True)\n",
        "\n",
        "# Paso 4: Título\n",
        "plt.title(\"Set 5 - Correlación\")\n",
        "\n",
        "# Paso 5: Mostrar\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# =========================================\n",
        "# SET 6 - GRÁFICA DE PASTEL\n",
        "# =========================================\n",
        "# Aquí mostramos proporciones de categorías\n",
        "\n",
        "# Paso 1: Datos\n",
        "categorias = ['A', 'B', 'C', 'D']\n",
        "valores = np.array([35, 25, 22, 18])\n",
        "\n",
        "# Paso 2: Figura\n",
        "plt.figure()\n",
        "\n",
        "# Paso 3: Gráfica de pastel\n",
        "plt.pie(valores, labels=categorias, autopct='%1.1f%%')\n",
        "\n",
        "# Paso 4: Título\n",
        "plt.title(\"Set 6 - Proporciones\")\n",
        "\n",
        "# Paso 5: Mostrar\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# =========================================\n",
        "# SET 7 - ESPECTRO DE FRECUENCIAS\n",
        "# =========================================\n",
        "# Aquí analizamos las frecuencias de una señal\n",
        "\n",
        "# Paso 1: Datos\n",
        "fs = 500\n",
        "T  = 2.0\n",
        "t7 = np.linspace(0, T, int(fs*T), endpoint=False)\n",
        "\n",
        "f1, f2 = 50, 120\n",
        "signal = 1.0*np.sin(2*np.pi*f1*t7) + 0.6*np.sin(2*np.pi*f2*t7) + 0.3*np.random.normal(0,1,len(t7))\n",
        "\n",
        "Y = np.fft.rfft(signal)\n",
        "freqs = np.fft.rfftfreq(len(t7), d=1/fs)\n",
        "amplitud = np.abs(Y) / len(t7)\n",
        "\n",
        "# Paso 2: Figura\n",
        "plt.figure()\n",
        "\n",
        "# Paso 3: Gráfica\n",
        "plt.plot(freqs, amplitud)\n",
        "\n",
        "# Paso 4: Título\n",
        "plt.title(\"Set 7 - Espectro de frecuencias\")\n",
        "\n",
        "# Paso 5: Mostrar\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# =========================================\n",
        "# SET 8 - GRÁFICA DE BURBUJAS\n",
        "# =========================================\n",
        "# Aquí representamos tres variables: X, Y y tamaño\n",
        "\n",
        "# Paso 1: Datos\n",
        "n = 60\n",
        "X = np.random.uniform(10, 100, size=n)\n",
        "Y = 1.5 * X + np.random.normal(0, 15, size=n)\n",
        "S = np.random.uniform(50, 1500, size=n)\n",
        "\n",
        "# Paso 2: Figura\n",
        "plt.figure()\n",
        "\n",
        "# Paso 3: Gráfica de burbujas\n",
        "plt.scatter(X, Y, s=S)\n",
        "\n",
        "# Paso 4: Título\n",
        "plt.title(\"Set 8 - Gráfica de burbujas\")\n",
        "\n",
        "# Paso 5: Mostrar\n",
        "plt.show()"
      ]
    }
  ]
